{
  "manifest_version": 3,
  "name": "Game Sites - Aperçu Screenshots",
  "version": "1.3.0",
  "description": "Affiche les captures d'écran d'un jeu directement sous sa carte sur SkidrowReloaded, IGG-Games et PCGamesTorrents.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.skidrowreloaded.com/*",
    "https://igg-games.com/*",
    "https://pcgamestorrents.com/*",
    "https://store.steampowered.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Réglages des tailles"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.skidrowreloaded.com/*",
        "https://igg-games.com/*",
        "https://pcgamestorrents.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "game-sites-screenshots@local-extension",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/Traycken/Crack-Game-Screenshots/main/updates.json"
    }
  }
}
